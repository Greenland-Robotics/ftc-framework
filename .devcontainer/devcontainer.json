{
  // A ready-to-build FTC environment (JDK 17, Android SDK, adb), so nothing Java-related is
  // needed on your computer. Open it with ./open-workspace.
  "name": "FTC Framework",

  // Prebuilt from .devcontainer/Dockerfile by .github/workflows/devcontainer-image.yml.
  // If you change the Dockerfile in your own repository, point this at your own image, or
  // replace it with: "build": { "dockerfile": "Dockerfile", "options": ["--platform=linux/amd64"] }
  "image": "ghcr.io/greenland-robotics/ftc-framework/devcontainer:latest",
  "runArgs": ["--platform=linux/amd64"],

  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  // Gradle's file watching doesn't work under x86 emulation; turn it off to avoid noisy errors
  "containerEnv": {
    "GRADLE_OPTS": "-Dorg.gradle.vfs.watch=false"
  },

  // Keep Gradle and its downloads between container rebuilds
  "mounts": [
    "source=ftc-framework-gradle,target=/home/vscode/.gradle,type=volume"
  ],

  // The behavior tree visualizer (examples/general/visualizer) serves its web page on this port.
  // VS Code forwards it, so http://localhost:8765 works in the browser on your computer.
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": { "label": "Behavior tree visualizer", "onAutoForward": "openBrowserOnce" }
  },

  // Download dependencies and generate the Java project VS Code loads (gradle/vscode.gradle).
  // As an onCreateCommand it finishes before VS Code starts its Java extension, which would
  // otherwise start without the project and report every file as a "non-project file".
  "onCreateCommand": "./gradlew --console=plain :robot:vscodeClasspath",

  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vscjava.vscode-gradle"
      ]
    }
  }
}
