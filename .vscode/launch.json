{
  // Run and Debug configurations (the ▷ in the sidebar). Breakpoints work in your nodes too.
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Examples",
      "request": "launch",
      "mainClass": "Examples",
      // The project gradle/vscode.gradle generates, named after the repository folder. Naming it
      // keeps the launch unambiguous if another checkout's project is also in the workspace.
      "projectName": "${workspaceFolderBasename}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "type": "java",
      "name": "Hive game",
      "request": "launch",
      "mainClass": "hive.HiveMatch",
      "projectName": "${workspaceFolderBasename}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "type": "java",
      "name": "Tuning demo",
      "request": "launch",
      "mainClass": "tunedemo.TuneDemo",
      "projectName": "${workspaceFolderBasename}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
