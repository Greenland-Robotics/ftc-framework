{
  // Android Gradle projects can't be imported by VS Code's Java extension, so Gradle import is
  // off and it loads the Eclipse project (.project, .classpath) generated by the
  // "Refresh VS Code classpath" task (./gradlew :robot:vscodeClasspath) instead.
  "java.import.gradle.enabled": false,
  "java.import.maven.enabled": false,
  "java.gradle.buildServer.enabled": "off",

  "search.exclude": {
    "**/build": true,
    "**/.gradle": true,
    ".vscode/classpath": true
  }
}
